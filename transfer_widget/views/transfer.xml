<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="sale_view_order_form_inherit" model="ir.ui.view">
        <field name="name">view_order_form_inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page/field[@name='order_line']/list/field[@name='qty_delivered']" position="after">
                <widget name="transfer_widget"/>
            </xpath>
        </field>
    </record>

    <record id="transfer_widget_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">transfer_widget_purchase_order_form_inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page/field[@name='order_line']/list/field[@name='qty_received']" position="after">
                <widget name="transfer_widget"/>
            </xpath>
        </field>
    </record>

    <record id="transfer_widget_mrp_production_tree_view_inherit" model="ir.ui.view">
        <field name="name">transfer_widget_mrp_production_tree_view_inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <widget name="transfer_widget"/>
            </xpath>
        </field>
    </record>

</odoo>